{
  "agents": [
    "antigravity-cli",
    "claude-code",
    "codex",
    "copilot-cli",
    "cursor-cli",
    "droid",
    "kiro-cli",
    "opencode",
    "pi"
  ],
  "project_instruction_files": [
    "CLAUDE.md",
    "AGENTS.md",
    "SYSTEM.md",
    ".claude/CLAUDE.md",
    "AGENTS.override.md",
    "APPEND_SYSTEM.md",
    ".github/copilot-instructions.md",
    "GEMINI.md"
  ],
  "global_instruction_files": [
    "~/.claude/CLAUDE.md",
    "~/.codex/AGENTS.md",
    "~/.pi/agent/AGENTS.md",
    "~/.codex/AGENTS.override.md",
    "~/.copilot/copilot-instructions.md",
    "~/.config/opencode/AGENTS.md",
    "~/.gemini/AGENTS.md",
    "~/.gemini/GEMINI.md"
  ],
  "max_instruction_file_chars": 20000,
  "max_instructions_total_chars": 140000,
  "known_hook_tools": [
    "black",
    "eslint",
    "mypy",
    "pc:block_pip",
    "pc:format_after_edit",
    "pc:lint_after_edit",
    "pc:no_data_commit",
    "pc:no_secrets_commit",
    "pc:protect_paths",
    "pc:tests_before_done",
    "pc:typecheck",
    "pip",
    "pre-commit",
    "prettier",
    "pyright",
    "pytest",
    "ruff",
    "ruff-check",
    "ruff-format",
    "uv"
  ],
  "hook_events": [
    "PostToolUse",
    "PreToolUse",
    "Stop",
    "UserPromptSubmit"
  ],
  "hook_moments": [
    "after_tool",
    "before_prompt",
    "before_tool",
    "turn_end"
  ],
  "project_signals": [
    "jupyter",
    "marimo",
    "matplotlib",
    "numpy",
    "pandas",
    "plotly",
    "polars",
    "python",
    "seaborn",
    "sklearn"
  ],
  "linters": [
    "black",
    "flake8",
    "mypy",
    "pylint",
    "pyright",
    "ruff"
  ],
  "forbidden_names": [
    ".env",
    ".envrc",
    ".git-credentials",
    ".htpasswd",
    ".netrc",
    ".npmrc",
    ".pgpass",
    ".pypirc",
    "credentials.json",
    "secrets.toml"
  ],
  "forbidden_suffixes": [
    ".pem",
    ".key",
    ".p12",
    ".pfx",
    ".jks",
    ".keystore",
    ".tfvars",
    ".tfvars.json",
    ".env"
  ],
  "forbidden_path_endings": [
    "/.aws/credentials",
    "/.docker/config.json",
    "/.kube/config"
  ],
  "env_template_suffixes": [
    ".example",
    ".sample",
    ".template",
    ".dist"
  ],
  "command_pattern": "coach(?:[,:]\\s*|\\s+)(?:please\\s+)?(?:(?:be\\s+)?(?P<cmd>quieter|quiet down|louder|more|off|on|status|prompt[- ]only (?:on|off))(?:\\s+please)?[.!?]*|(?P<say>helpful|very helpful|that helped|that helps|that was helpful|that(?:['\\u2019]s| is) helpful|thanks|thank you|not helpful|unhelpful|that was not helpful|that wasn['\\u2019]?t helpful|that(?:['\\u2019]s| is) not helpful|that did not help|that didn['\\u2019]?t help|learning (?:on|off)|opt out of learning|opt (?:in to|into) learning)(?:\\s+please)?[.!]*)",
  "command_flags": [
    "ASCII",
    "IGNORECASE"
  ],
  "command_synonyms": [
    "helpful",
    "learning off",
    "learning on",
    "louder",
    "more",
    "not helpful",
    "off",
    "on",
    "opt in to learning",
    "opt into learning",
    "opt out of learning",
    "prompt only off",
    "prompt only on",
    "quiet down",
    "quieter",
    "status",
    "thank you",
    "thanks",
    "that did not help",
    "that didn't help",
    "that didnt help",
    "that helped",
    "that helps",
    "that is helpful",
    "that is not helpful",
    "that was helpful",
    "that was not helpful",
    "that wasn't helpful",
    "that wasnt helpful",
    "that's helpful",
    "that's not helpful",
    "unhelpful",
    "very helpful"
  ]
}
